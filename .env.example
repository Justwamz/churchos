# ---- Messaging (SMS via Onfon Mobile, email via Resend). See docs/going-live-messaging.md ----
# Default is mock for both: nothing leaves the machine.
MESSAGING_MODE=mock
# MESSAGING_MODE=live needs all four of these:
ONFON_API_KEY=
ONFON_CLIENT_ID=
ONFON_ACCESS_KEY=
ONFON_SENDER_ID=
# Optional Onfon settings
# ONFON_BASE_URL=https://api.onfonmedia.co.ke/v1/sms
# ONFON_SEND_PATH=/SendBulkSMS
# ONFON_ACCESS_KEY_HEADER=AccessKey
# ONFON_BATCH_SIZE=100
# ONFON_TIMEOUT_MS=20000
# ONFON_APPROVED_SENDER_IDS=CHURCH,GRACE
# ONFON_DLR_SECRET=
EMAIL_MODE=mock
# EMAIL_MODE=live needs both of these:
RESEND_API_KEY=
RESEND_FROM=
# Optional Resend settings
# RESEND_REPLY_TO=
# RESEND_WEBHOOK_SECRET=whsec_
# RESEND_TIMEOUT_MS=15000

# ---- Payments (M-Pesa Daraja, Airtel Money, Paystack). See docs/going-live-payments.md ----
# Default is the simulator: no money moves. PSP_MODE=live needs at least one provider below; a provider with missing settings is off.
PSP_MODE=mock
# TRUST_PROXY=1
# M-Pesa (Daraja): all six to switch on
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_BASE=https://api.example.org
# MPESA_CALLBACK_TOKEN=
# Payouts and refunds by M-Pesa (B2C)
# MPESA_INITIATOR_NAME=
# MPESA_INITIATOR_PASSWORD=
# MPESA_CERT_PATH=
# MPESA_ALLOWED_IPS=
# Airtel Money: first four to switch on
# AIRTEL_ENV=sandbox
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=
# AIRTEL_CALLBACK_BASE=https://api.example.org
# AIRTEL_CALLBACK_TOKEN=
# AIRTEL_WEBHOOK_KEY=
# Paystack (cards, bank payouts)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_FALLBACK_EMAIL_DOMAIN=example.com
# PAYSTACK_RETURN_URL=
